generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  phone     String?
  upiId     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  groups    GroupMember[]
  expensesPaid Expense[]      @relation("PaidBy")
  splits       ExpenseSplit[]
}

model Group {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  members   GroupMember[]
  expenses  Expense[]
}
model Expense {
  id          String         @id @default(cuid())
  group       Group          @relation(fields: [groupId], references: [id])
  groupId     String
  description String
  amountPaise Int            // store money as integer paise to avoid float rounding issues
  paidBy      User           @relation("PaidBy", fields: [paidById], references: [id])
  paidById    String
  splitType   SplitType
  createdAt   DateTime       @default(now())
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id              String  @id @default(cuid())
  expense         Expense @relation(fields: [expenseId], references: [id])
  expenseId       String
  user            User    @relation(fields: [userId], references: [id])
  userId          String
  amountOwedPaise Int
}

enum SplitType {
  EQUAL
  EXACT
  SHARES
}
model GroupMember {
  id       String   @id @default(cuid())
  group    Group    @relation(fields: [groupId], references: [id])
  groupId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Settlement {
  id                String    @id @default(cuid())
  groupId           String
  fromUserId        String
  toUserId          String
  amountPaise       Int
  status            String    @default("pending") // pending | payer_confirmed | both_confirmed | disputed
  payerConfirmedAt  DateTime?
  payeeConfirmedAt  DateTime?
  disputeReason     String?
  createdAt         DateTime  @default(now())
}



model RecurringTemplate {
  id            String   @id @default(cuid())
  groupId       String
  description   String
  amountPaise   Int
  splitType     SplitType
  shareUnits    Json?     // e.g. { "userId1": 20, "userId2": 12 } — meal counts, only used when splitType = SHARES
  frequencyDays Int       // e.g. 30 for monthly, 7 for weekly
  nextRunAt     DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}