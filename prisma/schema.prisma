generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String             @id @default(cuid())
  email                    String?            @unique
  name                     String?
  phone                    String?
  upiId                    String?
  role                     String             @default("member")
  isPlaceholder            Boolean            @default(false)
  isDeleted                Boolean            @default(false)
  deletedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  groups                   GroupMember[]
  expensesPaid             Expense[]          @relation("PaidBy")
  createdExpenses          Expense[]          @relation("CreatedExpenses")
  splits                   ExpenseSplit[]
  editPermissionsRequested EditPermission[]   @relation("RequestedPermissions")
  editPermissionsOwned     EditPermission[]   @relation("OwnedPermissions")
  pushSubscriptions        PushSubscription[]
  expensePayments          ExpensePayment[]   @relation("ExpensePayments")
  vendorProfile            Vendor?
  vendorSubscriptions      VendorSubscriber[] @relation("VendorSubscriptions") // NEW
  tenantReceipts   RentReceipt[] @relation("TenantReceipts")
  landlordReceipts RentReceipt[] @relation("LandlordReceipts")
  trustScore TrustScore?
  kittiesOrganized     Kitty[]              @relation("KittyOrganizer")
  kittyContributions   KittyContribution[]  @relation("KittyContributor")
  kittyExpensesLogged  KittyExpense[]       @relation("KittySpender")
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  token     String    @unique @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model Group {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  members   GroupMember[]
  expenses  Expense[]
  invites   GroupInvite[]
}

model Expense {
  id                  String             @id @default(cuid())
  group               Group              @relation(fields: [groupId], references: [id])
  groupId             String
  description         String
  amountPaise         Int
  paidBy              User               @relation("PaidBy", fields: [paidById], references: [id])
  paidById            String
  createdBy           User               @relation("CreatedExpenses", fields: [createdById], references: [id]) // NEW
  createdById         String // NEW
  splitType           SplitType
  createdAt           DateTime           @default(now())
  splits              ExpenseSplit[]
  editPermissions     EditPermission[]
  payments            ExpensePayment[] // NEW
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
}

model ExpensePayment {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ExpensePayments", fields: [userId], references: [id])
  amountPaise Int
  createdAt   DateTime @default(now())

  @@unique([expenseId, userId]) // one row per contributor per expense; merges increment it
}

model ExpenseSplit {
  id              String  @id @default(cuid())
  expense         Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId       String
  user            User    @relation(fields: [userId], references: [id])
  userId          String
  amountOwedPaise Int
}

enum SplitType {
  EQUAL
  EXACT
  SHARES
  PERCENTAGE
}

model GroupMember {
  id       String   @id @default(cuid())
  group    Group    @relation(fields: [groupId], references: [id])
  groupId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Settlement {
  id               String    @id @default(cuid())
  groupId          String
  fromUserId       String
  toUserId         String
  amountPaise      Int
  status           String    @default("pending") // pending | payer_confirmed | both_confirmed | disputed
  paymentMethod    String    @default("upi") // "upi" | "cash"
  utrNumber        String?
  payerConfirmedAt DateTime?
  payeeConfirmedAt DateTime?
  disputeReason    String?
  createdAt        DateTime  @default(now())
}

model RecurringTemplate {
  id                String     @id @default(cuid())
  groupId           String
  description       String
  amountPaise       Int
  splitType         SplitType
  shareUnits        Json?
  frequencyDays     Int
  nextRunAt         DateTime
  active            Boolean    @default(true)
  pausedAt          DateTime?
  nextCycleOverride Json? // one-time override for next run only
  createdAt         DateTime   @default(now())
  generatedExpenses Expense[]
}

model EditPermission {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User     @relation("RequestedPermissions", fields: [requestedById], references: [id])
  ownerId       String
  owner         User     @relation("OwnedPermissions", fields: [ownerId], references: [id])
  action        String
  status        String   @default("pending")
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model PaymentReminder {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String // person being reminded — owes the money
  toUserId    String // person who sent the reminder — is owed the money
  amountPaise Int
  sentAt      DateTime @default(now())

  @@index([groupId, fromUserId, toUserId, sentAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id]) // NEW - fixes pushSubscriptions error
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Vendor {
  id            String              @id @default(cuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id])
  businessName  String              // e.g. "Sharma Mess", "Green Valley Apartments"
  businessType  String              // "mess" | "landlord" | "other"
  panNumber     String?             // for HRA receipts later
  upiId         String?             // where tenants pay
  createdAt     DateTime            @default(now())
  collections   VendorCollection[]
}

model VendorCollection {
  id              String                    @id @default(cuid())
  vendorId        String
  vendor          Vendor                    @relation(fields: [vendorId], references: [id])
  title           String
  amountPaise     Int
  dueDate         DateTime?
  cycleMonth      String?
  token           String                    @unique @default(cuid())
  openEnrollment  Boolean                   @default(false)
  propertyAddress String?                   // NEW — only meaningful when vendor.businessType = "landlord"
  createdAt       DateTime                  @default(now())
  subscribers     VendorSubscriber[]
  payments        VendorPayment[]
}

model VendorSubscriber {
  id            String           @id @default(cuid())
  collection    VendorCollection @relation(fields: [collectionId], references: [id])
  collectionId  String
  userId        String? // nullable now — null until the invited person logs in and claims it
  user          User?            @relation("VendorSubscriptions", fields: [userId], references: [id])
  name          String
  invitedEmail  String? // set when the vendor pre-adds someone by email, before they've claimed it
  createdAt     DateTime         @default(now())
  payment       VendorPayment?

  @@unique([collectionId, userId])
}

model RentReceipt {
  id                String    @id @default(cuid())
  vendorPaymentId   String    @unique
  vendorPayment     VendorPayment @relation(fields: [vendorPaymentId], references: [id])
  tenantId          String
  tenant            User      @relation("TenantReceipts", fields: [tenantId], references: [id])
  landlordId        String
  landlord          User      @relation("LandlordReceipts", fields: [landlordId], references: [id])
  landlordPan       String?
  propertyAddress   String
  amountPaise       Int
  paymentPeriodFrom DateTime
  paymentPeriodTo   DateTime
  utrNumber         String?
  status            String    @default("pending_signature")
  signedAt          DateTime?
  createdAt         DateTime  @default(now())
}

model VendorPayment {
  id             String           @id @default(cuid())
  collection     VendorCollection @relation(fields: [collectionId], references: [id])
  collectionId   String
  subscriber     VendorSubscriber @relation(fields: [subscriberId], references: [id])
  subscriberId   String           @unique
  amountPaise    Int
  paymentMethod  String           @default("upi")
  utrNumber      String?
  status         String           @default("pending")
  paidAt         DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime         @default(now())
  rentReceipt    RentReceipt?
}

model TrustScore {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])
  score                 Int      @default(50) // 0-100, starts neutral for new users
  label                 String   @default("New member") // "New member" | "Building trust" | "Usually reliable" | "Reliable" | "Highly reliable"
  onTimeRate            Float    @default(0) // 0.0 - 1.0
  disputeRate           Float    @default(0)
  utrSubmissionRate     Float    @default(0)
  completionRate        Float    @default(0)
  totalSettlements      Int      @default(0) // sample size — low sample sizes get a "New member" label regardless of score
  lastCalculatedAt      DateTime @default(now())
}

model Kitty {
  id              String              @id @default(cuid())
  title           String
  description     String?
  targetPaise     Int
  organizerId     String
  organizer       User                @relation("KittyOrganizer", fields: [organizerId], references: [id])
  deadline        DateTime?
  status          String              @default("collecting") // "collecting" | "closed" | "refunded"
  token           String              @unique @default(cuid()) // for the contribute link
  collectorUpiId  String?             // where contributions actually get paid to (organizer's or a nominated collector's UPI ID)
  createdAt       DateTime            @default(now())
  closedAt        DateTime?
  contributions   KittyContribution[]
  expenses        KittyExpense[]
}

model KittyContribution {
  id              String    @id @default(cuid())
  kittyId         String
  kitty           Kitty     @relation(fields: [kittyId], references: [id])
  userId          String
  user            User      @relation("KittyContributor", fields: [userId], references: [id])
  amountPaise     Int       // what they were asked to contribute (target / contributor count, or custom)
  paidAmountPaise Int?      // what they actually paid — null until they contribute
  paymentMethod   String?   // "upi" | "cash"
  utrNumber       String?
  status          String    @default("pending") // "pending" | "paid" | "confirmed"
  paidAt          DateTime?
  confirmedAt     DateTime?
  refundPaise     Int?      // calculated when the kitty closes, if there's a leftover
  refundStatus    String?   // "pending" | "sent" | "confirmed" — null until kitty closes
  createdAt       DateTime  @default(now())

  @@unique([kittyId, userId])
}

model KittyExpense {
  id          String   @id @default(cuid())
  kittyId     String
  kitty       Kitty    @relation(fields: [kittyId], references: [id])
  description String
  amountPaise Int
  spentById   String
  spentBy     User     @relation("KittySpender", fields: [spentById], references: [id])
  createdAt   DateTime @default(now())
}