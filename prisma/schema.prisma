generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  phone         String?
  upiId         String?
  isPlaceholder Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  groups        GroupMember[]
  expensesPaid  Expense[]     @relation("PaidBy")
  splits        ExpenseSplit[]
  editPermissionsRequested EditPermission[] @relation("RequestedPermissions")
  editPermissionsOwned     EditPermission[] @relation("OwnedPermissions")
  createdExpensesOwned     Expense[]        @relation("CreatedExpenses")
  expensePayments          ExpensePayment[] @relation("ExpensePayments")
}

model GroupInvite {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model Group {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  members   GroupMember[]
  expenses  Expense[]
  invites   GroupInvite[]
}

model Expense {
  id              String           @id @default(cuid())
  group           Group            @relation(fields: [groupId], references: [id])
  groupId         String
  description     String
  amountPaise     Int
  paidBy          User             @relation("PaidBy", fields: [paidById], references: [id])
  paidById        String
  createdBy       User             @relation("CreatedExpenses", fields: [createdById], references: [id])   // NEW
  createdById     String                                                                                     // NEW
  splitType       SplitType
  createdAt       DateTime         @default(now())
  splits          ExpenseSplit[]
  editPermissions EditPermission[]
  payments        ExpensePayment[]                                                                           // NEW
}

model ExpensePayment {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ExpensePayments", fields: [userId], references: [id])
  amountPaise Int
  createdAt   DateTime @default(now())

  @@unique([expenseId, userId]) // one row per contributor per expense; merges increment it
}

model ExpenseSplit {
  id              String  @id @default(cuid())
  expense         Expense @relation(fields: [expenseId], references: [id])
  expenseId       String
  user            User    @relation(fields: [userId], references: [id])
  userId          String
  amountOwedPaise Int
}

enum SplitType {
  EQUAL
  EXACT
  SHARES
  PERCENTAGE
}
model GroupMember {
  id       String   @id @default(cuid())
  group    Group    @relation(fields: [groupId], references: [id])
  groupId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Settlement {
  id                String    @id @default(cuid())
  groupId           String
  fromUserId        String
  toUserId          String
  amountPaise       Int
  status            String    @default("pending") // pending | payer_confirmed | both_confirmed | disputed
  paymentMethod    String    @default("upi") // "upi" | "cash"
  utrNumber        String?
  payerConfirmedAt  DateTime?
  payeeConfirmedAt  DateTime?
  disputeReason     String?
  createdAt         DateTime  @default(now())
}



model RecurringTemplate {
  id            String   @id @default(cuid())
  groupId       String
  description   String
  amountPaise   Int
  splitType     SplitType
  shareUnits    Json?     // e.g. { "userId1": 20, "userId2": 12 } — meal counts, only used when splitType = SHARES
  frequencyDays Int       // e.g. 30 for monthly, 7 for weekly
  nextRunAt     DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model EditPermission {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User     @relation("RequestedPermissions", fields: [requestedById], references: [id])
  ownerId       String
  owner         User     @relation("OwnedPermissions", fields: [ownerId], references: [id])
  action        String
  status        String   @default("pending")
  notified      Boolean  @default(false)  
  createdAt     DateTime @default(now())
}

model PaymentReminder {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String   // person being reminded — owes the money
  toUserId    String   // person who sent the reminder — is owed the money
  amountPaise Int
  sentAt      DateTime @default(now())

  @@index([groupId, fromUserId, toUserId, sentAt])
}
